<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import ui.effects.ParticleField?>
<?import ui.effects.RadialPane?>

<!-- TIPO SANGUÍNEO: aparece depois de "Iniciar" no Novo Jogo. Os botões dos tipos são criados pelo
     controller (BloodTypeController.initialize) e distribuídos em círculo pelo RadialPane.
     Comportamento: ui/screens/BloodTypeController.java -->
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="ui.screens.BloodTypeController"
           styleClass="screen">
    <ParticleField/>

    <!-- Os tipos sanguíneos, em círculo em volta da tela -->
    <RadialPane fx:id="ring" radiusFactor="0.36"/>

    <!-- Centro: instrução, escolha atual e botão de começar -->
    <VBox alignment="CENTER" spacing="12" maxWidth="360" maxHeight="-Infinity" pickOnBounds="false">
        <Label text="Tipo Sanguíneo" styleClass="title" textAlignment="CENTER"/>
        <Label text="Escolha o sangue que corre nas veias de Emily." styleClass="text" wrapText="true"
               textAlignment="CENTER"/>
        <Label fx:id="selectedLabel" styleClass="blood-selected"/>
        <Button fx:id="startButton" text="Começar" onAction="#onStart" styleClass="menu-button"/>
    </VBox>

    <Button text="Voltar" onAction="#onBack" styleClass="menu-button" StackPane.alignment="BOTTOM_LEFT">
        <StackPane.margin>
            <Insets bottom="8" left="8"/>
        </StackPane.margin>
    </Button>
</StackPane>
