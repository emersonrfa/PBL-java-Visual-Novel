<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<!-- CARREGAR SAVE. As linhas de cada slot são criadas pelo controller dentro de "slotsBox".
     Comportamento: ui/screens/LoadSaveController.java -->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ui.screens.LoadSaveController"
            styleClass="screen">
    <top>
        <Label text="Carregar Jogo" styleClass="title" BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll">
            <VBox fx:id="slotsBox" spacing="10" styleClass="panel"/>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="8" alignment="CENTER">
            <Label fx:id="statusLabel" styleClass="status"/>
            <Button text="Voltar" onAction="#onBack" styleClass="menu-button"/>
        </VBox>
    </bottom>
</BorderPane>
