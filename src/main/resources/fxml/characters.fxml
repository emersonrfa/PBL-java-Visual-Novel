<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- GALERIA DE PERSONAGENS. Setas (ou as teclas ← →) trocam de personagem; os botões
     "Sprites disponíveis" trocam a imagem. Os textos e botões de sprite são preenchidos pelo
     controller. Comportamento: ui/screens/CharacterGalleryController.java -->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="root" fx:controller="ui.screens.CharacterGalleryController"
            styleClass="screen">
    <top>
        <VBox alignment="CENTER" spacing="4">
            <Label text="Galeria de Personagens" styleClass="title"/>
            <Label fx:id="counterLabel" styleClass="text-muted"/>
        </VBox>
    </top>
    <center>
        <HBox alignment="CENTER" spacing="18">
            <padding>
                <Insets top="6" bottom="6"/>
            </padding>
            <Button fx:id="previousButton" text="◀" onAction="#onPrevious" styleClass="nav-arrow"/>

            <!-- Retrato do sprite escolhido -->
            <StackPane styleClass="portrait-frame" minWidth="400" prefWidth="400" maxWidth="400">
                <ImageView fx:id="portrait" preserveRatio="true" fitWidth="380" fitHeight="470" smooth="true"/>
                <Label fx:id="noSpriteLabel" text="Sem sprite ainda" styleClass="text-muted" visible="false"/>
            </StackPane>

            <!-- Ficha do personagem -->
            <VBox spacing="8" prefWidth="520" minWidth="520" maxWidth="520" styleClass="panel">
                <Label fx:id="nameLabel" styleClass="title-small" wrapText="true"/>
                <Label fx:id="roleLabel" styleClass="gallery-role"/>
                <Label fx:id="metaLabel" styleClass="text-muted"/>
                <ScrollPane fitToWidth="true" prefHeight="190" styleClass="bag-scroll">
                    <Label fx:id="descriptionLabel" styleClass="text" wrapText="true"/>
                </ScrollPane>
                <Label text="Sprites disponíveis" styleClass="status-section"/>
                <FlowPane fx:id="spriteBox" hgap="8" vgap="8"/>
            </VBox>

            <Button fx:id="nextButton" text="▶" onAction="#onNext" styleClass="nav-arrow"/>
        </HBox>
    </center>
    <bottom>
        <VBox alignment="CENTER">
            <Button text="Voltar" onAction="#onBack" styleClass="menu-button"/>
        </VBox>
    </bottom>
</BorderPane>
