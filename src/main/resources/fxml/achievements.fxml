<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<!-- GALERIA DE CONQUISTAS. As linhas são criadas pelo controller dentro de "listBox".
     Comportamento: ui/screens/AchievementsController.java -->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ui.screens.AchievementsController"
            styleClass="screen">
    <top>
        <VBox alignment="CENTER" spacing="6">
            <Label text="Galeria de Conquistas" styleClass="title"/>
            <Label fx:id="progressLabel" styleClass="text"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll">
            <VBox fx:id="listBox" spacing="10" styleClass="panel"/>
        </ScrollPane>
    </center>
    <bottom>
        <VBox alignment="CENTER">
            <Button text="Voltar" onAction="#onBack" styleClass="menu-button"/>
        </VBox>
    </bottom>
</BorderPane>
